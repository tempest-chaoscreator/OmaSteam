{
  "name": "OmaSteam",
  "author": "Tempest (based on Rose)",
  "description": "Metro by Rose, with Omarchy colors.toml synced through a theme-set hook.",
  "source": "https://github.com/tempest-chaoscreator/OmaSteam",
  "github":
  {
    "owner": "tempest-chaoscreator",
    "repo_name": "OmaSteam"
  },
  "tags":
  [
    "Dark",
    "Metro",
    "Windows 10",
    "Windows 8"
  ],
  "header_image": "https://raw.githubusercontent.com/tempest-chaoscreator/OmaSteam/master/preview.png",
  "splash_image": "https://i.imgur.com/PQF7r4t.png",
  "Steam-WebKit": "webkit.css",
  "UseDefaultPatches": true,
  "Patches":
  [
        {
          "MatchRegexString": "^DUMMYFORCONFIG$",
          "TargetCss": "custom.css"
        },
        {
          "MatchRegexString": "^Menu$|^useBrowserViewContextMenu$",
          "TargetCss": "menu.custom.css"
        },
        {
          "MatchRegexString": "^notificationtoasts_",
          "TargetCss": "notifications.custom.css"
        },
        {
          "MatchRegexString": "^OverlayRemotePlayTogether$",
          "TargetCss": "friends.custom.css"
        }
  ]
}

