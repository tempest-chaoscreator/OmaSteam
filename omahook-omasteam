#!/usr/bin/env bash
# Omarchy theme-set hook: write OmaSteam/custom.css from colors.toml, then
# reload the Steam UI via Millennium (RestartJSContext). Steam process,
# downloads, and games stay up. Friends List may close.
set -uo pipefail

THEME_NATIVE="OmaSteam"
SKIN_DIR="$HOME/.steam/steam/millennium/themes/$THEME_NATIVE"
OUT_CSS="$SKIN_DIR/custom.css"

CANDIDATES=(
	"$HOME/.local/state/omarchy/current/theme/colors.toml"
	"$HOME/.config/omarchy/current/theme/colors.toml"
)
COLORS_TOML=""
for c in "${CANDIDATES[@]}"; do
	[[ -f "$c" ]] && COLORS_TOML="$c" && break
done
[[ -z "$COLORS_TOML" ]] && { echo "[omahook-omasteam] colors.toml not found, skipping" >&2; exit 0; }
[[ -d "$SKIN_DIR" ]] || { echo "[omahook-omasteam] $SKIN_DIR not found -- run install.sh" >&2; exit 0; }

get() {
	grep -E "^[[:space:]]*$1[[:space:]]*=" "$COLORS_TOML" \
		| head -n1 | sed -E 's/^[^=]+=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/' || true
}

to_rgb() {
	local hex="${1#\#}"
	[[ ${#hex} -eq 6 ]] || { echo ""; return; }
	printf '%d, %d, %d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

MODE="$(get mode)"; [[ -z "$MODE" ]] && MODE="dark"
BACKGROUND="$(get background)"
ACCENT="$(get accent)"
LIGHTER_BG="$(get lighter_background)"
COLOR0="$(get color0)"
COLOR8="$(get color8)"

CLIENT_BG="$(to_rgb "${BACKGROUND:-#101315}")"
FOCUS="$(to_rgb "${ACCENT:-#0072c6}")"
FRAME_BORDER="$(to_rgb "${LIGHTER_BG:-${COLOR8:-#404040}}")"
HEADER_DARK="$(to_rgb "${COLOR0:-$BACKGROUND}")"

{
	echo "/* Generated by omahook-omasteam -- do not edit by hand */"
	echo "html:root"
	echo "{"
	echo "--focus: ${FOCUS};"
	echo "--clientBG: ${CLIENT_BG};"
	echo "--frameBorder: ${FRAME_BORDER};"
	echo "--header_dark: ${HEADER_DARK};"
	echo "--bgGameList: var(--header_dark);"
	echo "--white05onbgGameList: ${FRAME_BORDER};"
	echo "--textentry: var(--header_dark);"

	if [[ "$MODE" == "light" ]]; then
		# From Metro by Rose's Metro White block -- alpha overlays and
		# re-colored icons, not a specific hue. Light/dark switch only.
		cat <<'LIGHTBLOCK'
--white03: 0, 0, 0, 0.03;
--white05: 0, 0, 0, 0.05;
--white08: 0, 0, 0, 0.08;
--white10: 0, 0, 0, 0.10;
--white12: 0, 0, 0, 0.12;
--white15: 0, 0, 0, 0.15;
--white20: 0, 0, 0, 0.20;
--white24: 0, 0, 0, 0.24;
--white25: 0, 0, 0, 0.25;
--white35: 0, 0, 0, 0.35;
--white45: 0, 0, 0, 0.45;
--white50: 0, 0, 0, 0.50;
--white75: 0, 0, 0, 0.75;
--white: 0, 0, 0;
--black03: 255, 255, 255, 0.03;
--black08: 255, 255, 255, 0.08;
--black05: 255, 255, 255, 0.05;
--black10: 255, 255, 255, 0.10;
--black12: 255, 255, 255, 0.12;
--black15: 255, 255, 255, 0.15;
--black20: 255, 255, 255, 0.20;
--black24: 255, 255, 255, 0.24;
--black35: 255, 255, 255, 0.35;
--black25: 255, 255, 255, 0.25;
--black45: 255, 255, 255, 0.45;
--black75: 255, 255, 255, 0.75;
--black: 255, 255, 255;
--gameinfoiconfilter: invert(1);
LIGHTBLOCK
	fi

	echo "}"
} > "$OUT_CSS"

echo "[omahook-omasteam] wrote $OUT_CSS (mode=$MODE)"

# Same action as Millennium's "Restart Now": re-enable OmaSteam with
# UIReloadProps.Force -> SteamClient.Browser.RestartJSContext().
if pgrep -x steam >/dev/null 2>&1; then
	steam "steam://millennium/settings/themes/enable/${THEME_NATIVE}" >/dev/null 2>&1
	echo "[omahook-omasteam] asked Millennium to reload Steam UI"
fi
